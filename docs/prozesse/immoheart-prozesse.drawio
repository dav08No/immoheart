<mxfile host="app.diagrams.net" type="device"><diagram name="1 Überblick" id="1 Über"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 Ü1" value="" style="rounded=0;html=1;fillColor=#252321;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1650" height="110" as="geometry"/></mxCell><mxCell id="1 Ü2" value="" style="ellipse;html=1;fillColor=#FF1C38;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="42" height="42" as="geometry"/></mxCell><mxCell id="1 Ü3" value="1" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="42" height="30" as="geometry"/></mxCell><mxCell id="1 Ü4" value="Was ist immoheart?" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=28;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="24" width="1100" height="40" as="geometry"/></mxCell><mxCell id="1 Ü5" value="Die Vermittlungsplattform von espaceSOLOTHURN für Gewerbeflächen in der Region Solothurn" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#D9D2CC;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="66" width="1300" height="30" as="geometry"/></mxCell><mxCell id="1 Ü6" value="immoheart · Prozesse" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#D9D2CC;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1390" y="30" width="220" height="24" as="geometry"/></mxCell><mxCell id="1 Ü7" value="&lt;b&gt;Das Problem vorher&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="470" height="24" as="geometry"/></mxCell><mxCell id="1 Ü8" value="Anfragen nach Büro-, Gewerbe- oder Lagerflächen kamen ungeordnet per E-Mail und wurden von Hand in Trello erfasst. Das kostete Zeit, und ältere Anfragen gingen vergessen: Wurde Monate später eine passende Fläche frei, dachte niemand mehr an die Firma, die sie gesucht hatte." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#5F5752;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="470" height="140" as="geometry"/></mxCell><mxCell id="1 Ü9" value="&lt;b&gt;Die Lösung&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="470" height="24" as="geometry"/></mxCell><mxCell id="1 Ü10" value="immoheart sammelt Suchaufträge und Flächen an einem Ort und gleicht sie automatisch ab, &lt;b&gt;in beide Richtungen&lt;/b&gt;: jede neue Suche gegen alle Flächen und jede neue Fläche gegen alle offenen Suchen, auch Monate alte. Die KI liest Mails und schreibt Antwort-Entwürfe. Das Team prüft alles und sendet von Hand." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#5F5752;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="470" height="150" as="geometry"/></mxCell><mxCell id="1 Ü11" value="&lt;b&gt;Ziel&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Jede Firma findet schnell die passende Fläche, und keine Anfrage geht vergessen.&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FF1C38;strokeColor=#FF1C38;fontColor=#FFFFFF;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="470" height="90" as="geometry"/></mxCell><mxCell id="1 Ü12" value="&lt;b&gt;Suchende Firmen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;suchen Büro, Gewerbe, Produktion, Lager, Verkauf oder Bauland&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E3EEF9;strokeColor=#3F73A6;fontColor=#16324F;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="570" y="150" width="250" height="100" as="geometry"/></mxCell><mxCell id="1 Ü13" value="&lt;b&gt;Eigentümer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;haben eine freie Fläche und möchten sie vermieten oder verkaufen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E4F2E7;strokeColor=#3E8A55;fontColor=#173B22;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="250" height="100" as="geometry"/></mxCell><mxCell id="1 Ü14" value="&lt;b&gt;Öffentliche Website&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Objekte ansehen · Suchauftrag · Inserieren&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="970" y="150" width="260" height="100" as="geometry"/></mxCell><mxCell id="1 Ü15" value="&lt;b&gt;Mail-Postfach&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;immoheart.business@gmail.com, alle 2 Min. abgerufen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="970" y="520" width="260" height="100" as="geometry"/></mxCell><mxCell id="1 Ü16" value="&lt;b style='font-size:20px'&gt;immoheart&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Anfragen · Objekte · automatischer Abgleich · KI-Entwürfe&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#252321;strokeColor=#FF1C38;strokeWidth=3;fontColor=#FFFFFF;spacing=12;" vertex="1" parent="1"><mxGeometry x="970" y="335" width="260" height="110" as="geometry"/></mxCell><mxCell id="1 Ü17" value="&lt;b&gt;Team espaceSOLOTHURN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;prüft Vorschläge, sendet Mails, schliesst Vermittlungen ab&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1360" y="335" width="250" height="110" as="geometry"/></mxCell><mxCell id="1 Ü18" value="Formular" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü12" target="1 Ü14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü19" value="oder Mail" style="rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 Ü12" target="1 Ü15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü20" value="Mail + Fotos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü13" target="1 Ü15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü14" target="1 Ü16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü15" target="1 Ü16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü23" value="Vorschläge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü16" target="1 Ü17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü24" value="Angebot per Mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#FF1C38;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 Ü17" target="1 Ü12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1485" y="130"/><mxPoint x="695" y="130"/></Array></mxGeometry></mxCell><mxCell id="1 Ü25" value="Info per Mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#FF1C38;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="1 Ü17" target="1 Ü13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1485" y="650"/><mxPoint x="695" y="650"/></Array></mxGeometry></mxCell><mxCell id="1 Ü26" value="&lt;b&gt;Der Weg einer Vermittlung&lt;/b&gt; (jede Station hat eine eigene Seite in dieser Datei)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1200" height="26" as="geometry"/></mxCell><mxCell id="1 Ü27" value="&lt;b&gt;2 · Suchende&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Suchauftrag wird zur Anfrage&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E3EEF9;strokeColor=#3F73A6;fontColor=#16324F;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="250" height="90" as="geometry"/></mxCell><mxCell id="1 Ü28" value="&lt;b&gt;3 · Eigentümer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Fläche wird zum Objekt&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E4F2E7;strokeColor=#3E8A55;fontColor=#173B22;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="355" y="735" width="250" height="90" as="geometry"/></mxCell><mxCell id="1 Ü29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü27" target="1 Ü28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü30" value="&lt;b&gt;4 · Matching&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Abgleich und Angebot&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="670" y="735" width="250" height="90" as="geometry"/></mxCell><mxCell id="1 Ü31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü28" target="1 Ü30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü32" value="&lt;b&gt;5 · Abschluss&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;reserviert, vermietet, Absagen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="985" y="735" width="250" height="90" as="geometry"/></mxCell><mxCell id="1 Ü33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü30" target="1 Ü32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü34" value="&lt;b&gt;6 · Pflege&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Puls, Nachfassen, Archiv, Rapport&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="1300" y="735" width="250" height="90" as="geometry"/></mxCell><mxCell id="1 Ü35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="1 Ü32" target="1 Ü34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1 Ü36" value="&lt;b&gt;Wichtig:&lt;/b&gt; Keine Mail verlässt immoheart automatisch. Die KI schreibt nur Entwürfe; jede Mail wird vom Team geprüft und von Hand gesendet." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1570" height="56" as="geometry"/></mxCell><mxCell id="1 Ü37" value="&lt;b&gt;Legende&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="90" height="24" as="geometry"/></mxCell><mxCell id="1 Ü38" value="" style="rounded=1;arcSize=20;html=1;fillColor=#E3EEF9;strokeColor=#3F73A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="950" width="30" height="30" as="geometry"/></mxCell><mxCell id="1 Ü39" value="Suchende Firma" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="957" width="200" height="20" as="geometry"/></mxCell><mxCell id="1 Ü40" value="" style="rounded=1;arcSize=20;html=1;fillColor=#E4F2E7;strokeColor=#3E8A55;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="306" y="950" width="30" height="30" as="geometry"/></mxCell><mxCell id="1 Ü41" value="Eigentümer" style="text;html=1;whiteSpace=wrap;fon