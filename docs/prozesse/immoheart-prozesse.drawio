.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5 A15" target="5 A18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="5 A15" target="5 A19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A33" value="&lt;b&gt;Wenn der Eigentümer selbst meldet&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="700" height="26" as="geometry"/></mxCell><mxCell id="5 A34" value="&lt;b&gt;Mail vom Eigentümer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;«Die Fläche ist nicht mehr verfügbar» oder «wieder frei»&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E4F2E7;strokeColor=#3E8A55;fontColor=#173B22;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="230" height="100" as="geometry"/></mxCell><mxCell id="5 A35" value="&lt;b&gt;KI erkennt «Objektmeldung»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;ordnet die Mail dem Objekt zu, Dank-Entwurf an den Eigentümer&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="350" y="720" width="240" height="100" as="geometry"/></mxCell><mxCell id="5 A36" value="Was meldet er?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#FFF6DA;strokeColor=#C9A227;fontColor=#4A3A05;strokeWidth=2;spacing=14;" vertex="1" parent="1"><mxGeometry x="660" y="715" width="170" height="110" as="geometry"/></mxCell><mxCell id="5 A37" value="&lt;b&gt;Klick: «als vermietet markieren»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Treffer werden erledigt, Absage-Entwürfe an betroffene Firmen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="280" height="100" as="geometry"/></mxCell><mxCell id="5 A38" value="&lt;b&gt;Klick: «wieder verfügbar setzen»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Objekt wieder online, neuer Abgleich mit allen Anfragen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="280" height="100" as="geometry"/></mxCell><mxCell id="5 A39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="5 A34" target="5 A35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="5 A35" target="5 A36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A41" value="nicht verfügbar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5 A36" target="5 A37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A42" value="wieder frei" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5 A36" target="5 A38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5 A43" value="&lt;b&gt;Wichtig:&lt;/b&gt; Jede dieser Aktionen zeigt vorher einen Dialog mit allen Folgen (z. B. «2 andere Firmen erhalten einen Absage-Entwurf»). Erst der Klick ändert etwas." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1230" y="740" width="380" height="110" as="geometry"/></mxCell><mxCell id="5 A44" value="&lt;b&gt;Legende&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="90" height="24" as="geometry"/></mxCell><mxCell id="5 A45" value="" style="rounded=1;arcSize=20;html=1;fillColor=#E3EEF9;strokeColor=#3F73A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="950" width="30" height="30" as="geometry"/></mxCell><mxCell id="5 A46" value="Suchende Firma" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="957" width="200" height="20" as="geometry"/></mxCell><mxCell id="5 A47" value="" style="rounded=1;arcSize=20;html=1;fillColor=#E4F2E7;strokeColor=#3E8A55;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="306" y="950" width="30" height="30" as="geometry"/></mxCell><mxCell id="5 A48" value="Eigentümer" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="344" y="957" width="200" height="20" as="geometry"/></mxCell><mxCell id="5 A49" value="" style="rounded=1;arcSize=20;html=1;fillColor=#FFFFFF;strokeColor=#8F847D;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="454" y="950" width="30" height="30" as="geometry"/></mxCell><mxCell id="5 A50" value="immoheart (automatisch / KI)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="492" y="957" width="200" height="20" as="geometry"/></mxCell><mxCell id="5 A51" value="" style="rounded=1;arcSize=20;html=1;fillColor=#282828;strokeColor=#282828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="728" y="950" width="30" height="30" as="geometry"/></mxCell><mxCell id="5 A52" value="Team espaceSOLOTHURN" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="766" y="957" width="200" height="20" as="geometry"/></mxCell><mxCell id="5 A53" value="" style="rounded=1;arcSize=20;html=1;fillColor=#FFF1F2;strokeColor=#FF1C38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="946" y="950" width="30" height="30" as="geometry"/></mxCell><mxCell id="5 A54" value="Mail-Entwurf / Versand" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="984" y="957" width="200" height="20" as="geometry"/></mxCell><mxCell id="5 A55" value="" style="rhombus;html=1;fillColor=#FFF6DA;strokeColor=#C9A227;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1178" y="950" width="30" height="30" as="geometry"/></mxCell><mxCell id="5 A56" value="Entscheidung" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1216" y="957" width="200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6 Pflege und Auswertung" id="6 Pfle"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6 P1" value="" style="rounded=0;html=1;fillColor=#252321;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1650" height="110" as="geometry"/></mxCell><mxCell id="6 P2" value="" style="ellipse;html=1;fillColor=#FF1C38;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="42" height="42" as="geometry"/></mxCell><mxCell id="6 P3" value="6" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="42" height="30" as="geometry"/></mxCell><mxCell id="6 P4" value="Im Alltag: dranbleiben, aufbewahren, auswerten" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=28;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="24" width="1100" height="40" as="geometry"/></mxCell><mxCell id="6 P5" value="Was dafür sorgt, dass keine Anfrage vergessen geht" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#D9D2CC;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="66" width="1300" height="30" as="geometry"/></mxCell><mxCell id="6 P6" value="immoheart · Prozesse" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#D9D2CC;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1390" y="30" width="220" height="24" as="geometry"/></mxCell><mxCell id="6 P7" value="&lt;b&gt;Bestandspuls: wie frisch ist der Kontakt?&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="760" height="26" as="geometry"/></mxCell><mxCell id="6 P8" value="Jede offene Anfrage hat einen Puls von 100. Er sinkt jeden Tag ohne Kontakt um 1. Jede gesendete oder empfangene Mail setzt ihn wieder auf 100." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#5F5752;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="172" width="740" height="50" as="geometry"/></mxCell><mxCell id="6 P9" value="&lt;b&gt;Gut&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Puls 60 bis 100&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#EAF3EE;strokeColor=#0F6E56;fontColor=#0F6E56;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="220" height="70" as="geometry"/></mxCell><mxCell id="6 P10" value="&lt;b&gt;Nachfassen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Puls 25 bis 59&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FBF0DF;strokeColor=#965210;fontColor=#965210;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="310" y="240" width="220" height="70" as="geometry"/></mxCell><mxCell id="6 P11" value="&lt;b&gt;Kritisch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Puls unter 25&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#F8EBEB;strokeColor=#9B3232;fontColor=#9B3232;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="220" height="70" as="geometry"/></mxCell><mxCell id="6 P12" value="&lt;font style='font-size:11px;opacity:0.7'&gt;1&lt;/font&gt;&lt;br&gt;&lt;b&gt;«Lange nichts gehört»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;die Anfragen mit dem längsten Kontaktabstand auf «Matches»&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="230" height="100" as="geometry"/></mxCell><mxCell id="6 P13" value="&lt;font style='font-size:11px;opacity:0.7'&gt;2&lt;/font&gt;&lt;br&gt;&lt;b&gt;«Nachfass entwerfen»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;KI fragt nach, ob die Suche noch aktuell ist&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="340" y="350" width="220" height="100" as="geometry"/></mxCell><mxCell id="6 P14" value="&lt;font style='font-size:11px;opacity:0.7'&gt;3&lt;/font&gt;&lt;br&gt;&lt;b&gt;Team sendet&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="610" y="350" width="180" height="100" as="geometry"/></mxCell><mxCell id="6 P15" value="&lt;b&gt;Puls wieder frisch&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FF1C38;strokeColor=#FF1C38;fontColor=#FFFFFF;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="610" y="490" width="180" height="70" as="geometry"/></mxCell><mxCell id="6 P16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="6 P12" target="6 P13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="6 P13" target="6 P14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="6 P14" target="6 P15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P19" value="&lt;b&gt;Mails abrufen&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="140" width="700" height="26" as="geometry"/></mxCell><mxCell id="6 P20" value="&lt;b&gt;Automatisch alle 2 Minuten&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;solange der Admin-Bereich offen ist; dazu der Knopf «Jetzt abrufen» im Postfach&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="340" height="100" as="geometry"/></mxCell><mxCell id="6 P21" value="&lt;b&gt;KI ordnet jede Mail ein&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Suchanfrage · Antwort · Objektangebot · Objektmeldung · Sonstiges&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="1270" y="180" width="340" height="100" as="geometry"/></mxCell><mxCell id="6 P22" value="&lt;b&gt;Archiv statt Löschen&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="700" height="26" as="geometry"/></mxCell><mxCell id="6 P23" value="&lt;b&gt;Archivieren&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Treffer, Objekte und Anfragen verschwinden aus den Listen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="900" y="370" width="220" height="100" as="geometry"/></mxCell><mxCell id="6 P24" value="&lt;b&gt;Archiv&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;alles bleibt erhalten (Rapportpflicht)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="1160" y="370" width="200" height="100" as="geometry"/></mxCell><mxCell id="6 P25" value="&lt;b&gt;Wiederherstellen&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1400" y="340" width="210" height="60" as="geometry"/></mxCell><mxCell id="6 P26" value="&lt;b&gt;Endgültig löschen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;nur Admin, mit Warnung und Bestätigung&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1400" y="430" width="210" height="80" as="geometry"/></mxCell><mxCell id="6 P27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="6 P23" target="6 P24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6 P24" target="6 P25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6 P24" target="6 P26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P30" value="&lt;b&gt;Zahlen und Jahresrapport&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=17;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="900" height="26" as="geometry"/></mxCell><mxCell id="6 P31" value="&lt;b&gt;Seite «Zahlen»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Anfragen pro Monat, Vermittlungsquote, Tage bis Angebot und Abschluss, gesuchte Grössen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="300" height="110" as="geometry"/></mxCell><mxCell id="6 P32" value="&lt;b&gt;«Jahresrapport erstellen»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;ein Klick&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="420" y="660" width="220" height="110" as="geometry"/></mxCell><mxCell id="6 P33" value="&lt;b&gt;Excel-Datei&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;letzte 12 Monate: Übersicht, Diagramme, KI-Zusammenfassung, alle Daten&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="700" y="660" width="300" height="110" as="geometry"/></mxCell><mxCell id="6 P34" value="&lt;b&gt;Rapport für espaceSOLOTHURN&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FF1C38;strokeColor=#FF1C38;fontColor=#FFFFFF;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1060" y="675" width="250" height="80" as="geometry"/></mxCell><mxCell id="6 P35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="6 P31" target="6 P32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="6 P32" target="6 P33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="6 P33" target="6 P34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6 P38" value="&lt;b&gt;Wichtig:&lt;/b&gt; Daten werden nicht gelöscht, sondern archiviert. So bleiben alle Vermittlungen für den Jahresrapport nachvollziehbar." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1570" height="56" as="geometry"/></mxCell><mxCell id="6 P39" value="&lt;b&gt;Legende&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="90" height="24" as="geometry"/></mxCell><mxCell id="6 P40" value="" style="rounded=1;arcSize=20;html=1;fillColor=#FFFFFF;strokeColor=#8F847D;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="130" y="920" width="30" height="30" as="geometry"/></mxCell><mxCell id="6 P41" value="immoheart (automatisch / KI)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="927" width="200" height="20" as="geometry"/></mxCell><mxCell id="6 P42" value="" style="rounded=1;arcSize=20;html=1;fillColor=#282828;strokeColor=#282828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="404" y="920" width="30" height="30" as="geometry"/></mxCell><mxCell id="6 P43" value="Team espaceSOLOTHURN" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="442" y="927" width="200" height="20" as="geometry"/></mxCell><mxCell id="6 P44" value="" style="rounded=1;arcSize=20;html=1;fillColor=#FFF1F2;strokeColor=#FF1C38;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="622" y="920" width="30" height="30" as="geometry"/></mxCell><mxCell id="6 P45" value="Mail-Entwurf / Versand" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="660" y="927" width="200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="7 Gespeicherte Daten" id="7 Gesp"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7 G1" value="" style="rounded=0;html=1;fillColor=#252321;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1650" height="110" as="geometry"/></mxCell><mxCell id="7 G2" value="" style="ellipse;html=1;fillColor=#FF1C38;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="42" height="42" as="geometry"/></mxCell><mxCell id="7 G3" value="7" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=18;fontColor=#FFFFFF;align=center;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="42" height="30" as="geometry"/></mxCell><mxCell id="7 G4" value="Was immoheart speichert" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=28;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="24" width="1100" height="40" as="geometry"/></mxCell><mxCell id="7 G5" value="Die gespeicherten Daten in Alltagssprache und wie sie zusammenhängen" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#D9D2CC;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="100" y="66" width="1300" height="30" as="geometry"/></mxCell><mxCell id="7 G6" value="immoheart · Prozesse" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#D9D2CC;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1390" y="30" width="220" height="24" as="geometry"/></mxCell><mxCell id="7 G7" value="&lt;div style='background:#3F73A6;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Firmen&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;wer eine Fläche sucht&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Firmenname und Branche&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Website&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Ansprechperson und Mailadresse&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F3F8FD;strokeColor=#3F73A6;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="280" height="123" as="geometry"/></mxCell><mxCell id="7 G8" value="&lt;div style='background:#3F73A6;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Anfragen&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;was eine Firma sucht&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Nutzungsart (Büro, Lager …)&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Fläche von–bis (m²)&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Ort und Budget pro m²&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• ab wann&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• besondere Wünsche (z. B. Rampe)&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Stand: offen, ruhend, vermittelt&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• letzter Kontakt (für den Puls)&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Quelle: Mail, Website, von Hand&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F3F8FD;strokeColor=#3F73A6;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="400" y="160" width="320" height="218" as="geometry"/></mxCell><mxCell id="7 G9" value="&lt;div style='background:#282828;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Treffer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;eine Anfrage passt zu einem Objekt&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• welche Anfrage, welches Objekt&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Trefferquote in %&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Begründung: was passt, was nicht&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Stand: neu, angeboten, reserviert, vermittelt …&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Datum von Angebot, Reservierung, Vertrag&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F4F0EE;strokeColor=#282828;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="320" height="161" as="geometry"/></mxCell><mxCell id="7 G10" value="&lt;div style='background:#3E8A55;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Objekte&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;freie Flächen&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Titel und Beschreibung&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Ort, Fläche und Preis pro m²&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Nutzungsart und Ausstattung&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• verfügbar ab&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Adresse und Eigentümer (nur intern)&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• auf der Website sichtbar: ja/nein&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Stand: verfügbar, reserviert, vermietet&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F3FAF4;strokeColor=#3E8A55;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1200" y="160" width="410" height="199" as="geometry"/></mxCell><mxCell id="7 G11" value="&lt;div style='background:#8F847D;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Archiv&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;statt löschen&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• archivierte Anfragen und Objekte&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Kopie entfernter Treffer&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Datum und Grund&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• kann wiederhergestellt werden&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FAF9F5;strokeColor=#8F847D;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="280" height="142" as="geometry"/></mxCell><mxCell id="7 G12" value="&lt;div style='background:#C8102E;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Mails&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;alles, was rein- und rausgeht&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• eingegangene Mails und Website-Formulare&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Entwürfe der KI und gesendete Mails&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Absender, Empfänger, Betreff, Text&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Art laut KI (Suchanfrage, Antwort, Objektangebot …)&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• von der KI erkannte Angaben&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• gehört zu einer Anfrage, einem Treffer oder Objekt&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• gelesen, empfangen am, gesendet am&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF5F6;strokeColor=#C8102E;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="720" height="199" as="geometry"/></mxCell><mxCell id="7 G13" value="&lt;div style='background:#3E8A55;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Fotos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Bilder der Objekte, öffentlich&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Bilddatei&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Reihenfolge (1. Bild = Titelbild)&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#F3FAF4;strokeColor=#3E8A55;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1200" y="470" width="410" height="104" as="geometry"/></mxCell><mxCell id="7 G14" value="&lt;div style='background:#C8102E;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Mail-Anhänge&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Bilder und PDFs aus Mails, privat&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Datei mit Name, Art und Grösse&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFF5F6;strokeColor=#C8102E;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="410" height="85" as="geometry"/></mxCell><mxCell id="7 G15" value="&lt;div style='background:#8F847D;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Team-Konten&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;wer sich im Admin anmelden darf&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Name&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• aktiv oder gesperrt&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• darf Konten verwalten: ja/nein&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FAF9F5;strokeColor=#8F847D;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="280" height="123" as="geometry"/></mxCell><mxCell id="7 G16" value="&lt;div style='background:#8F847D;color:#fff;padding:7px 12px'&gt;&lt;b style='font-size:17px'&gt;Im Hintergrund&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Technik, die man nicht sieht&lt;/span&gt;&lt;/div&gt;&lt;table style='margin:6px 12px;font-size:12px;color:#3A3633;border-collapse:collapse'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;padding:0 10px 0 0'&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Zeitpunkt des letzten Mail-Abrufs&lt;/div&gt;&lt;div style='margin:0;line-height:19px;white-space:nowrap'&gt;• Spamschutz für die Website-Formulare&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FAF9F5;strokeColor=#8F847D;strokeWidth=2;verticalAlign=top;align=left;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="400" y="760" width="720" height="104" as="geometry"/></mxCell><mxCell id="7 G17" value="stellt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="7 G7" target="7 G8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7 G18" value="passt zu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="7 G8" target="7 G9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="7 G19" value="passt zu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.