: Nutzung, Ort, Fläche, Budget, Bezug&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E3EEF9;strokeColor=#3F73A6;fontColor=#16324F;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="310" y="160" width="220" height="80" as="geometry"/></mxCell><mxCell id="2 S15" value="&lt;font style='font-size:11px;opacity:0.7'&gt;1&lt;/font&gt;&lt;br&gt;&lt;b&gt;oder Mail an immoheart&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;formlos, mit Checkliste auf der Website&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E3EEF9;strokeColor=#3F73A6;fontColor=#16324F;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="310" y="250" width="220" height="80" as="geometry"/></mxCell><mxCell id="2 S16" value="&lt;font style='font-size:11px;opacity:0.7'&gt;2&lt;/font&gt;&lt;br&gt;&lt;b&gt;Eingang im Postfach&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Website: Angaben schon geordnet. Mail: KI erkennt Art und Angaben&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="640" y="410" width="230" height="100" as="geometry"/></mxCell><mxCell id="2 S17" value="Angaben vollständig?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#FFF6DA;strokeColor=#C9A227;fontColor=#4A3A05;strokeWidth=2;spacing=14;" vertex="1" parent="1"><mxGeometry x="930" y="405" width="170" height="110" as="geometry"/></mxCell><mxCell id="2 S18" value="&lt;font style='font-size:11px;opacity:0.7'&gt;3&lt;/font&gt;&lt;br&gt;&lt;b&gt;KI schreibt Rückfrage-Entwurf&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;fragt nach, was fehlt (z. B. «Budget?»)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="640" y="630" width="230" height="100" as="geometry"/></mxCell><mxCell id="2 S19" value="&lt;font style='font-size:11px;opacity:0.7'&gt;4&lt;/font&gt;&lt;br&gt;&lt;b&gt;Team prüft und sendet&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Text anpassen, dann «Senden»&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="340" y="630" width="220" height="100" as="geometry"/></mxCell><mxCell id="2 S20" value="&lt;font style='font-size:11px;opacity:0.7'&gt;5&lt;/font&gt;&lt;br&gt;&lt;b&gt;«Als Anfrage speichern»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Firma wird angelegt oder verknüpft&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1130" y="630" width="220" height="100" as="geometry"/></mxCell><mxCell id="2 S21" value="&lt;b&gt;Anfrage ist offen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;wird sofort mit allen Objekten abgeglichen → Seite 4&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FF1C38;strokeColor=#FF1C38;fontColor=#FFFFFF;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1400" y="410" width="210" height="100" as="geometry"/></mxCell><mxCell id="2 S22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exit