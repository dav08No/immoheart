th=2;spacing=14;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="180" height="110" as="geometry"/></mxCell><mxCell id="5 A9" value="&lt;b&gt;Abgelehnt&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Firma hat kein Interesse. Die KI erkennt das in der Antwort&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E3EEF9;strokeColor=#3F73A6;fontColor=#16324F;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="5 A10" value="&lt;font style='font-size:11px;opacity:0.7'&gt;1&lt;/font&gt;&lt;br&gt;&lt;b&gt;Reservieren&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Objekt ist reserviert&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="200" height="90" as="geometry"/></mxCell><mxCell id="5 A11" value="&lt;b&gt;Info an Eigentümer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;«Ihre Fläche ist reserviert»&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="600" y="150" width="200" height="80" as="geometry"/></mxCell><mxCell id="5 A12" value="&lt;b&gt;Andere Firmen mit Angebot&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;bekommen noch KEINE Absage, nur ein Hinweis im Admin&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="5 A13" value="Vertrag unterschrieben?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#FFF6DA;strokeColor=#C9A227;fontColor=#4A3A05;strokeWidth=2;spacing=14;" vertex="1" parent="1"><mxGeometry x="880" y="290" width="180" height="110" as="geometry"/></mxCell><mxCell id="5 A14" value="&lt;b&gt;Reservierung aufheben&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Objekt wieder verfügbar, Treffer wieder «Angeboten»&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="880" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="5 A15" value="&lt;b&gt;Vermittelt&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Objekt vermietet, Anfrage abgeschlossen&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FF1C38;strokeColor=#FF1C38;fontColor=#FFFFFF;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="220" height="90" as="geometry"/></mxCell><mxCell id="5 A16" value="&lt;b&gt;Bestätigung an die Firma&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1420" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="5 A17" value="&lt;b&gt;Info an Eigentümer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;«über immoheart vermietet»&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1420" y="260" width="190" height="70" as="geometry"/></mxCell><mxCell id="5 A18" value="&lt;b&gt;Absage an andere Firmen&lt;/b&gt;&lt;br&gt;&lt;font st