xGeometry></mxCell><mxCell id="7 G24" value="wenn erledigt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;dashed=1;dashPattern=6 4;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7 G8" target="7 G11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="438" y="440"/><mxPoint x="180" y="440"/></Array></mxGeometry></mxCell><mxCell id="7 G25" value="&lt;b&gt;Wichtig:&lt;/b&gt; Nichts geht verloren: Anfragen und Objekte werden archiviert, entfernte Treffer kopiert und verworfene Entwürfe nur markiert. Auf der Website sieht man nur Objekte und ihre Fotos; alles andere ist nur für das Team." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1570" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>