metry"><Array as="points"><mxPoint x="1240" y="460"/></Array></mxGeometry></mxCell><mxCell id="2 S31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="2 S20" target="2 S21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 S32" value="Auf der Website sieht die Firma nur eine Danke-Seite. Eine Bestätigung bekommt sie erst, wenn das Team die Antwort sendet." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#5F5752;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="900" y="200" width="560" height="40" as="geometry"/></mxCell><mxCell id="2 S33" value="&lt;b&gt;Wichtig:&lt;/b&gt; Fehlende Angaben sind kein Hindernis: Eine Anfrage lässt sich auch unvollständig speichern. Lücken erscheinen als «?» und können später ergänzt werden." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1570" height="56" as="geometry"/></mxCell><mxCell id="2 S34" value="&lt;b&gt;Legende&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="90" height="24" as="geometry"/></mxCell><mxCell id="2 S35" value="" style="rounded=1;arcSize=20;html=1;fillColor=#E3EEF9;strokeColor=#3F73A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="910" width="30" height="30" as="geometry"/></mxCell><mxCell id="2 S36" value="Suchende Firma" style="text;html=1;whiteSpace=wrap;fontFami