sendes Objekt neu dazukommt." style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1570" height="56" as="geometry"/></mxCell><mxCell id="4 M51" value="&lt;b&gt;Legende&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1016" width="90" height="24" as="geometry"/></mxCell><mxCell id="4 M52" value="" style="rounded=1;arcSize=20;html=1;fillColor=#E3EEF9;strokeColor=#3F73A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="130" y="1010" width="30" height="30" as="geometry"/></mxCell><mxCell id="4 M53" value="Suchende Firma" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="168" y="1017" width="200" height="20" as="geometry"/></mxCell><mxCell id="4 M54" value="" style="rounded=1;arcSize=20;html=1;fillColor=#E4F2E7;strokeColor=#3E8A55;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="306" y="1010" width="30" height="30" as="geometry"/></mxCell><mxCell id="4 M55" value="Eigentümer" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="344" y="1017" width="200" height="20" as="geometry"/></mxCell><mxCell id="4 M56" value="" style="rounded=1;arcSize=20;html=1;fillColor=#FFFFFF;strokeColor=#8F847D;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="454" y="1010" width="30" height="30" as="geometry"/></mxCell><mxCell id="4 M57" value="immoheart (automatisch / KI)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#282828;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="492" y