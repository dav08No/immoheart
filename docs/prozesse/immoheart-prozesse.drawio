ei" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#F4F0EE;strokeColor=#282828;fontColor=#282828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="215" width="150" height="50" as="geometry"/></mxCell><mxCell id="3 E14" value="&lt;font style='font-size:11px;opacity:0.7'&gt;1&lt;/font&gt;&lt;br&gt;&lt;b&gt;Mail mit Eckdaten und Fotos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Adresse, Fläche, Preis, Nutzung, ab wann frei; Fotos als Anhang&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#E4F2E7;strokeColor=#3E8A55;fontColor=#173B22;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="240" height="100" as="geometry"/></mxCell><mxCell id="3 E15" value="&lt;font style='font-size:11px;opacity:0.7'&gt;2&lt;/font&gt;&lt;br&gt;&lt;b&gt;KI erkennt «Objektangebot»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;liest die Angaben aus und speichert die Fotos&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="600" y="410" width="230" height="100" as="geometry"/></mxCell><mxCell id="3 E16" value="&lt;font style='font-size:11px;opacity:0.7'&gt;3&lt;/font&gt;&lt;br&gt;&lt;b&gt;Antwort-Entwurf&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Dank; fehlen Fotos, bittet er darum&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFF1F2;strokeColor=#FF1C38;fontColor=#7A0A18;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="600" y="630" width="230" height="100" as="geometry"/></mxCell><mxCell id="3 E17" value="&lt;font style='font-size:11px;opacity:0.7'&gt;4&lt;/font&gt;&lt;br&gt;&lt;b&gt;«Als Objekt übernehmen»&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Formular ist vorausgefüllt; Fotos aus dem Anhang übernehmen&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#282828;strokeColor=#282828;fontColor=#FFFFFF;strokeWidth=2;spacing=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="900" y="630" width="230" height="100" as="geometry"/></mxCell><mxCell id="3 E18" value="Auf der Website zeigen?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fillColor=#FFF6DA;strokeColor=#C9A227;fontColor=#4A3A05;strokeWidth=2;spacing=14;" vertex="1" parent="1"><mxGeometry x="1190" y="625" width="180" height="110" as="geometry"/></mxCell><mxCell id="3 E19" value="&lt;font style='font-size:11px;opacity:0.7'&gt;5&lt;/font&gt;&lt;br&gt;&lt;b&gt;Objekt ist online&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;ohne Adresse und ohne Eigentümer-Angaben&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fillColor=#FFFFFF;strokeColor=#8F847D;fontColor=#282828;strokeWidth=2;spacing=10;dashed=1;dashPattern=6 4;shadow=0;" vertex="1" parent="1"><mxGeometry x="1180" y="410" width="200" height="100" as="geometry"/></mxCell><mxCell id="3 E20" value="&lt;b&gt;Abgleich mit ALLEN offenen Anfragen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;auch mit Monate alten → Seite 4&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fillColor=#FF1C38;strokeColor=#FF1C38;fontColor=#FFFFFF;strokeWidth=2;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="410" width="190" height="100" as="geometry"/></mxCell><mxCell id="3 E21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;fontFamily=Helvetica;fontSize=12;strokeColor=#5F5752;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=8;fontColor=#282828;labelBackgroundColor=#FFFFFF;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="3 E13" targe